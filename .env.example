PORT=4000
DATABASE_PATH=./data/carepath.db
SESSION_TTL_DAYS=14
NODE_ENV=development

# Google Gemini (server-side only; never commit a real key — .env is git-ignored).
# Without a key the app still runs; AI generation returns a clear "not configured" error.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# AI safeguards
AI_TIMEOUT_MS=60000
AI_RATE_LIMIT_PER_HOUR=20
AI_MAX_CONCURRENT=4
AI_MAX_QUEUE=20
