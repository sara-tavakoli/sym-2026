{
  "name": "carepath-ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev:server": "tsx watch --env-file-if-exists=.env server/src/index.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "vite build --config web/vite.config.ts",
    "start": "tsx --env-file-if-exists=.env server/src/index.ts",
    "typecheck": "tsc -p server --noEmit && tsc -p web --noEmit",
    "test": "tsx --test server/test/*.test.ts",
    "eval": "tsx --env-file-if-exists=.env server/eval/run.ts",
    "ui-smoke": "tsx server/scripts/ui-smoke.ts",
    "ui-assistant": "tsx server/scripts/ui-assistant.ts",
    "ui-dashboard": "tsx server/scripts/ui-dashboard.ts",
    "ui-fitfinder": "tsx server/scripts/ui-fitfinder.ts",
    "ui-ai-features": "tsx server/scripts/ui-ai-features.ts",
    "ui-journey": "tsx server/scripts/ui-journey.ts",
    "seed": "tsx --env-file-if-exists=.env server/scripts/seed.ts"
  },
  "dependencies": {
    "@fontsource-variable/figtree": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.1",
    "@google/genai": "^2.30.0",
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "playwright-core": "^1.64.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
